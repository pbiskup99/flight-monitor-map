# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and is only ever read server-side by the Vite
# dev-server proxy plugin (vite.config.ts) — it is NEVER bundled into the
# browser-shipped client code.
#
# Generate an API Client (client_id + client_secret) from your OpenSky
# Network account: https://opensky-network.org/my-opensky/account -> API Client

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
